COMPOSE_FILE=../../src/compose.yml
COMPOSE_PROJECT_NAME=corporate

SITE_ADDRESS=https://corporate.example.com
UPLOAD_SITE_ADDRESS=https://upload.corporate.example.com
HTTP_BIND=80
HTTP_PORT=80
HTTPS_BIND=443
AUTH_MODE=enabled

BASIC_AUTH_USER=flag
BASIC_AUTH_HASH='' # Single quotes preserve the dollar signs in a Caddy bcrypt hash.

FLAG='EMU{real_flag_on_deployed}'
PLATFORM_ACCESS_KEY='key'
SESSION_SECRET='changeme'

REVIEW_SITE_ADDRESS=https://review.corporate.ctf.emu.team
SUPPORT_ADMIN_PASSWORD='changeme'
REVIEW_SESSION_SECRET=changeme

SUPPORT_DISCORD_WEBHOOK_URL=
SUPPORT_DISCORD_PING_TYPE=
SUPPORT_DISCORD_PING_ID=

POSTGRES_USER=mattermost
POSTGRES_PASSWORD=mattermost
POSTGRES_DB=mattermost




